# Copy to .env.local and fill in. .env.local is gitignored.

# Fine-grained token: Repository access = the app repos,
# Permissions > Repository > Secrets = Read and write,
# and Actions = Read and write for the Releases page.
GITHUB_TOKEN=

# Password for the console (user name: admin). Required; the console refuses
# every request until it is set.
CONSOLE_PASSWORD=

# Set to 1 to try the UI with an in-memory store instead of GitHub.
CONSOLE_DEMO=0
